# ต้องตรงกับ CHANNEL_SECRET ใน line-sim/.env
CHANNEL_SECRET=change-me
# base URL ของ LINE API (ชี้ไป line-sim)
LINE_API_BASE=http://localhost:5531
# port ของแอปนี้ (line-sim ต้องชี้ WEBHOOK_URL มาที่ http://localhost:3000/api/line/webhook)
PORT=3000

# Gemini API key for the AI summary in the referral letter (server-side only, read by vite.config.ts)
GEMINI_API_KEY=
